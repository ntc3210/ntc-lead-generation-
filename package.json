{
  "name": "ntc-lead-scout",
  "version": "0.1.0",
  "private": true,
  "description": "Lead Scout: an AI lead-generation coach for any company, with a small lead engine that only saves evidenced leads and only sends what the user approves. Built on Automaton by Conway Research (MIT).",
  "type": "module",
  "license": "MIT",
  "contributors": [
    "Conway Research (Automaton, https://github.com/Conway-Research/automaton): the original project this is built on",
    "ntc: the ntc-lead-scout additions"
  ],
  "keywords": [
    "lead-generation",
    "sales",
    "claude-code"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:leads": "tsc -p tsconfig.test.json && vitest run src/__tests__/leads",
    "leads:manual": "tsx src/leads/manual.ts",
    "leads:approve": "tsx src/leads/approval-server.ts",
    "leads:run": "tsx src/leads/runner.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1149.0",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
